@article{Raman2026DRS,
author = {Naveen Raman and Stephanie Milani and Fei Fang},
title = {Selecting Decision-Relevant Concepts in Reinforcement Learning},
journal = {arXiv preprint arXiv:2604.04808},
year = {2026},
keywords = {reinforcement learning, interpretability, concept bottleneck models, concept selection, state abstraction},
abstract = {We introduce the first principled algorithm for automatically selecting which human-understandable concepts a reinforcement learning agent should use, framing the problem through a state-abstraction view and providing provable performance bounds, replacing manual concept curation with a data-driven selection method.}
}
